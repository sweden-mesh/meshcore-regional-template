{{- /*
  The wizard pages are made by the template, not written as content: a region
  site gets them from its params (region, radio, naming) and nothing else.
  The intro texts are i18n keys, so a region can still reword them.
*/ -}}
{{- $pages := slice
  (dict "path" "repeater-snabb" "weight" 10 "title" (T "wz_quick_title") "description" (T "wz_quick_desc") "intro" (T "wz_quick_intro") "shortcode" "wizard-quick")
  (dict "path" "repeater-guidad" "weight" 20 "title" (T "wz_guided_title") "description" (T "wz_guided_desc") "intro" (T "wz_guided_intro") "shortcode" "wizard-guided")
  (dict "path" "companion" "weight" 30 "title" (T "wz_comp_title") "description" (T "wz_comp_desc") "intro" (T "wz_comp_intro") "shortcode" "wizard-companion")
-}}
{{- range $pages -}}
  {{- $.AddPage (dict
    "path" .path
    "title" .title
    "params" (dict "description" .description "lead" false)
    "description" .description
    "weight" .weight
    "content" (dict "mediaType" "text/markdown" "value" (printf "%s\n\n{{< %s >}}\n" .intro .shortcode))
  ) -}}
{{- end -}}
