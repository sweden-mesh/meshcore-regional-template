{{- /*
  National mode only (params.national): a front page for every county without a site of its own,
  at /<slug>/ (plan §6.2.2, §6.8). A county with its own site gets no page: its address redirects
  there (_redirects, layouts/lan/list.html; B-327). Nothing is added on a regional site.
*/ -}}
{{- /* The site flasher (B-298): one page, only on a site that turns it on. */ -}}
{{- if site.Params.firmware.flash -}}
  {{- $.AddPage (dict "path" "flasha" "kind" "page" "title" (T "fl_title") "description" (T "fl_desc")
        "params" (dict "description" (T "fl_desc") "lead" false)
        "content" (dict "mediaType" "text/markdown" "value" "{{< flasher >}}")) -}}
{{- end -}}
{{- if site.Params.national -}}
  {{- $all := partial "lan.html" . -}}
  {{- /* /lan/: every county, linking to its page or its own site; the no-JS target of the header's
         county button and the crawl path to every county page (§6.2.2). */ -}}
  {{- $.AddPage (dict "path" "lan" "kind" "page" "type" "lan" "layout" "list" "title" (T "lan_list_title") "description" (T "lan_list_desc")
        "params" (dict "description" (T "lan_list_desc")) "content" (dict "mediaType" "text/markdown" "value" "")) -}}
  {{- range $all -}}
    {{- if not .site -}}
      {{- $.AddPage (dict
        "path" .slug
        "kind" "page"
        "type" "lan"
        "layout" "county"
        "title" (T "hero_title" (dict "Region" .name))
        "description" (T "lan_home_desc" (dict "Name" .name "Scope" .scope))
        "params" (dict "lan" .scb "lanHome" true "lead" false
                  "description" (T "lan_home_desc" (dict "Name" .name "Scope" .scope)))
        "dates" (dict "lastmod" (time.AsTime .checked))
        "content" (dict "mediaType" "text/markdown" "value" "")) -}}
      {{- /* Three local pages per county (plan Q7.7, §6.8), modelled on meshcore-jkp.se's own:
             the text is assets/lan/*.md, run as a template with the county's values. */ -}}
      {{- $c := . -}}
      {{- $chat := "" }}{{ with .channels }}{{ $chat = (index . 0).name }}{{ end -}}
      {{- $names := slice }}{{ range .channels }}{{ $names = $names | append .name }}{{ end }}{{ $names = $names | append .test -}}
      {{- $ctx := dict "Name" .name "Short" .short "URL" .url "Scope" .scope "Proposal" (eq .decision "forslag")
            "Test" .test "Iata" (lower .iata) "Prefix" .prefix "Place" (.place | default (T "lan_place_example"))
            "Channels" $names "Chat" $chat "Groups" .groups "Chats" site.Params.chats "Wanted" .wanted
            "DataURL" (site.Params.lanData | default "")
            "Picker" (site.Params.firmware.picker | default "https://sweden-mesh.github.io/firmware/") -}}
      {{- range $p := slice
            (dict "path" "kom-igang" "title" (T "lan_start_title" (dict "Short" $c.short)) "desc" (T "lan_start_desc" (dict "Name" $c.name "Scope" $c.scope)))
            (dict "path" "ingen-svar-pa-test" "title" (T "lan_test_title" (dict "Test" $c.test)) "desc" (T "lan_test_desc" (dict "Test" $c.test)))
            (dict "path" "fragor" "title" (T "lan_faq_title" (dict "Name" $c.name)) "desc" (T "lan_faq_desc" (dict "Name" $c.name))) -}}
        {{- $body := resources.Get (printf "lan/%s.md" $p.path) | resources.ExecuteAsTemplate (printf "lan/%s/%s.md" $c.scb $p.path) $ctx -}}
        {{- $.AddPage (dict
          "path" (printf "%s/%s" $c.slug $p.path)
          "kind" "page"
          "type" "lan"
          "layout" "local"
          "title" $p.title
          "description" $p.desc
          "params" (dict "lan" $c.scb "description" $p.desc "searchPair" $p.path)
          "dates" (dict "lastmod" (time.AsTime $c.checked))
          "content" (dict "mediaType" "text/markdown" "value" $body.Content)) -}}
      {{- end -}}
    {{- end -}}
  {{- end -}}
{{- end -}}
